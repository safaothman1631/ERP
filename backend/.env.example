# ─────────────────────────────────────────────────────────────────────────────
# Zoho ERP Backend — Environment Variables
#
# Auto-generated from backend/app/utils/env_docs.py
# Copy this file to .env and fill in the values for your environment.
# Variables marked [REQUIRED in production] MUST be set before deploying.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ──────────────────────────────────────────────────────────────────────

# Deployment context.  Controls validation strictness, logging verbosity, and
# whether insecure defaults are permitted.
# [REQUIRED in production]
# Accepted values: "development" | "production".  In production, missing or insecure variables cause a hard startup failure.
ENVIRONMENT=development

# Display name shown in the UI and included in API responses.
# [Optional]
APP_NAME=Zoho Books Local

# Enables debug mode.  When true, detailed error tracebacks are returned in API
# responses and extra logging is emitted.
# [Optional]
# Must be false (or unset) in production.
DEBUG=false

# ── Security ──────────────────────────────────────────────────────────────────

# JWT signing secret used to sign and verify authentication tokens.  Must be a
# cryptographically random string of at least 32 characters.
# [REQUIRED in production]
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# NEVER commit the real value to source control.  This value is never written to logs or API responses.
SECRET_KEY=your-secret-key-here-change-in-production

# ── Database ──────────────────────────────────────────────────────────────────

# SQLAlchemy-compatible database connection string.  SQLite is used for local
# development; PostgreSQL is recommended for production.
# [REQUIRED in production]
# SQLite example:    sqlite:///./zoho_books.db
# PostgreSQL example: postgresql://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///./zoho_books.db

# ── CORS ──────────────────────────────────────────────────────────────────────

# Comma-separated list of allowed frontend origins for CORS.  The backend parses
# this list and applies it to the FastAPI CORS middleware.
# [REQUIRED in production]
# Do NOT use "*" in production — specify explicit origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# ── Firebase ──────────────────────────────────────────────────────────────────

# Filesystem path to the Firebase service-account JSON file used for Firestore
# and Firebase Auth access.
# [Optional]
# In Cloud Run, leave unset and rely on Application Default Credentials (ADC).  Required in production unless running on Cloud Run with a workload identity.
FIREBASE_CREDENTIALS_PATH=serviceAccountKey.json

# ── Payments ──────────────────────────────────────────────────────────────────

# Stripe secret API key for international SaaS billing (R5) and the tenant-side
# Stripe gateway (R4). Lazy-loaded — absence simply disables Stripe flows; it
# does not block startup.
# [Optional]
# Use sk_test_… in development and sk_live_… in production. Never commit the real value.
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Stripe publishable key surfaced to the browser for client-side payment
# confirmation.
# [Optional]
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Signing secret used to verify Stripe webhook payloads at POST /api/saas-
# billing/webhooks/stripe and the tenant-side payments webhook.
# [Optional]
# Obtain from the Stripe Dashboard → Developers → Webhooks for each endpoint.
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# Public base URL of the frontend, used to build tenant-facing payment links
# (invoice pay-link, hosted payment page).
# [Optional]
PUBLIC_APP_URL=https://app.example.com

# HMAC-SHA256 shared secret used to verify the PUBLIC Iraq payment webhooks
# (POST /api/iraq-payments/webhook/fib and /webhook/zain-cash). When
# empty/unset, those webhooks are disabled and return 503 so forged callbacks
# cannot mark invoices paid (safe-by-default).
# [Optional]
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Configure FIB/Zain Cash to sign each request with the X-Webhook-Signature header (hex digest of the raw request body). Never commit the real value.
IRAQ_PAYMENT_WEBHOOK_SECRET=change-me-iraq-payment-webhook-secret

# ── Support ───────────────────────────────────────────────────────────────────

# Crisp website ID used to boot the chat SDK and identify users.
# [Optional]
# Absent → chat widget no-ops cleanly. Frontend reads VITE_CRISP_WEBSITE_ID.
CRISP_WEBSITE_ID=00000000-0000-0000-0000-000000000000

# Crisp REST API identifier for server-side ticket forwarding.
# [Optional]
CRISP_API_IDENTIFIER=00000000-0000-0000-0000-000000000000

# Crisp REST API key paired with CRISP_API_IDENTIFIER.
# [Optional]
# Never commit the real value.
CRISP_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 360Dialog WhatsApp Business API key for inbound/outbound message routing.
# [Optional]
DIALOG360_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

# 360Dialog messages endpoint.
# [Optional]
DIALOG360_API_URL=https://waba.360dialog.io/v1/messages

# Statuspage.io OAuth key used by the 60s synthetic health emit job.
# [Optional]
STATUSPAGE_API_KEY=xxxxxxxxxxxxxxxxxxxx

# Statuspage.io page ID whose components are updated by the health emit job.
# [Optional]
STATUSPAGE_PAGE_ID=abc123def456

# JSON map of logical component name → Statuspage component ID.
# [Optional]
# Fetch IDs once provisioned: GET …/components.json.
STATUSPAGE_COMPONENTS={"api":"<id>","firestore":"<id>","pos_offline_sync":"<id>","email_delivery":"<id>"}

# Shared secret authorizing manual calls to internal cron endpoints (e.g.
# health-emit).
# [Optional]
INTERNAL_CRON_TOKEN=change-me-internal-cron-token

# ── Iraq Compliance ───────────────────────────────────────────────────────────

# Iraq Ministry of Finance e-Fakhata API base URL (HTTPS). When unset the
# submission worker holds the queue without erroring.
# [Optional]
# Endpoint paths/field shapes pending verification against the published MoF spec (R7.X).
MOF_BASE=https://efakhata.mof.gov.iq

# Set to 1 to bypass GCP Secret Manager and use the in-process PKCS#12 cert
# store (dev/CI only).
# [Optional]
EFAKHATA_LOCAL_CERT_STORE=1

# GCP project ID used to build Secret Manager resource names for tenant
# e-Fakhata certs.
# [Optional]
GCP_PROJECT_ID=my-gcp-project

# Central Bank of Iraq daily USD↔IQD rate source consumed by the 06:00 UTC
# refresh job.
# [Optional]
# Falls back to the previous day's rate (then a hardcoded 1320) on fetch failure. Format pending R7.6.
CBI_API_URL=https://cbi.iq/en/currency

# ── AI & Analytics ────────────────────────────────────────────────────────────

# BigQuery warehouse dataset as 'project.dataset' (e.g.
# 'zoho-83cda.zoho_warehouse'). When UNSET the analytics warehouse, BQML
# forecasts, and all AI insight endpoints are a graceful no-op (each returns a
# 'warehouse_not_configured' status, never a 500). Setting it opts the whole
# analytics/AI layer in.
# [Optional]
# The project half also pins the BigQuery client's billing project. Grant the runtime service account roles/bigquery.jobUser + roles/bigquery.dataEditor on this dataset before enabling.
ANALYTICS_BQ_DATASET=zoho-83cda.zoho_warehouse

# Anthropic API key that powers the natural-language data assistant
# (/api/ai/ask) and narrative business insights (/api/ai/insights). When UNSET,
# those endpoints return an 'ai_not_configured' status and never raise — the
# rest of the app is unaffected.
# [Optional]
# Get a key from https://console.anthropic.com/ . Never commit the real value. After setting it, verify with GET /api/ai/status?probe=true — a tiny live call confirms the key + model work.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional global override for BOTH AI models (translation + narrative). Set
# this to a single Claude model id to run every AI feature on one model — no
# code change. Per-task overrides below take precedence.
# [Optional]
# Any current Claude model id works — the assistant degrades gracefully from structured-output to plain-JSON parsing so the key 'just works' for any model. Resolution: AI_TRANSLATE_MODEL/AI_NARRATE_MODEL → AI_MODEL → built-in default.
AI_MODEL=claude-opus-4-8

# Override the model used for the NL→query translation step only (a constrained
# structured-extraction task; a fast/cheap model is ideal). Defaults to a
# current Haiku model when unset.
# [Optional]
AI_TRANSLATE_MODEL=claude-haiku-4-5

# Override the model used for the plain-language narrative summary only (prose
# quality matters; a stronger model is ideal). Defaults to a current Opus model
# when unset.
# [Optional]
AI_NARRATE_MODEL=claude-opus-4-8
