# Vercel / Production environment variables
# Set these in Vercel Dashboard → Project → Settings → Environment Variables
# for both Production and Preview environments.
#
# Firebase Console: https://console.firebase.google.com/
# Project: zoho-83cda → Project Settings → Your apps → Web app

# Firebase configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Backend API URL — set to your Cloud Run service URL
# Example: https://zoho-erp-xxxxx-uc.a.run.app
VITE_API_URL=

# Tenant settings v2 — module-gated nav + role-limited sections (default: enabled)
# VITE_TENANT_SETTINGS_V2 removed — tenant settings v2 is always on
