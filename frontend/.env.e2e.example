# E2E / Playwright environment (shopkeeper & scenario tests)
#
# Setup:
#   cp .env.e2e.example .env.e2e
#   # Edit .env.e2e with your staging or local values (.env.e2e is gitignored)
#
# Or use a local override only:
#   cp .env.e2e.example .env.e2e.local
#
# Run:
#   npm run dev          # frontend on :5173
#   # backend on :8000 (see backend README)
#   npm run e2e:shopkeeper

# Frontend URL Playwright opens in the browser
PLAYWRIGHT_BASE_URL=http://localhost:5173

# Backend API (auth + shopkeeper_core API checks)
API_BASE_URL=http://localhost:8000

# Optional alias used by some specs (defaults to API_BASE_URL in auth helper)
# PLAYWRIGHT_API_URL=http://localhost:8000

# Test tenant user — local demo org (seed: scripts/seed_role_demo_users.py --apply)
E2E_EMAIL=demo-manager@zohoerp.example.com
E2E_PASSWORD=Demo@2026

# Role-specific audits (optional — role-ux.spec.ts)
# E2E_USER_EMAIL=
# E2E_USER_PASSWORD=
# E2E_VIEWER_EMAIL=
# E2E_VIEWER_PASSWORD=
