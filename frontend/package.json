{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "vitest --run",
    "build": "vite build",
    "guard:compat": "node ./scripts/compat-guard.mjs",
    "nav:audit": "node ./scripts/nav-audit.mjs",
    "rtl:audit": "node ./scripts/rtl-audit.mjs",
    "lint:no-ua": "node ./scripts/no-ua-layout-detection.mjs",
    "i18n:coverage": "node ./scripts/i18n-coverage.mjs",
    "i18n:report": "node ./scripts/i18n-report.mjs",
    "help:report": "node ./scripts/help-report.mjs",
    "nav:sweep": "playwright test tests/e2e/nav-sweep.spec.ts",
    "route-walk": "playwright test --config tests/e2e/playwright.config.ts tests/e2e/route-walk.spec.ts",
    "help:coverage": "node ./scripts/verify-settings-help-coverage.mjs",
    "test:preservation": "node --test \"tests/preservation/*.spec.ts\" \"tests/preservation/*.spec.mjs\"",
    "lint": "eslint .",
    "preview": "vite preview",
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium",
    "e2e:report": "playwright show-report",
    "lhci": "lhci autorun",
    "lhci:no-regression": "node scripts/lighthouse-no-regression.mjs",
    "release:readiness": "node scripts/release-readiness.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "^6.1.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^9.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-query": "^5.100.10",
    "@types/react-grid-layout": "^1.3.6",
    "antd": "^6.3.5",
    "axios": "^1.14.0",
    "dayjs": "^1.11.20",
    "firebase": "^12.12.0",
    "framer-motion": "^12.38.0",
    "i18next": "^26.0.3",
    "i18next-http-backend": "^4.0.0",
    "react": "^19.2.4",
    "react-bits": "^1.0.0",
    "react-dom": "^19.2.4",
    "react-grid-layout": "^2.2.3",
    "react-i18next": "^17.0.2",
    "react-router-dom": "^7.14.0",
    "reactflow": "^11.11.4",
    "recharts": "^3.8.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.2",
    "@eslint/js": "^9.39.4",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.59.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "fast-check": "^3.23.2",
    "globals": "^17.4.0",
    "jsdom": "^29.1.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1",
    "vitest": "^4.1.6"
  }
}
