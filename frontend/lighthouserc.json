{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:5173/",
        "http://localhost:5173/login",
        "http://localhost:5173/dashboard",
        "http://localhost:5173/settings",
        "http://localhost:5173/sales/invoices"
      ],
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop",
        "throttling": {
          "rttMs": 150,
          "throughputKbps": 1638.4,
          "cpuSlowdownMultiplier": 4
        },
        "screenEmulation": {
          "mobile": true,
          "width": 375,
          "height": 812,
          "deviceScaleFactor": 3
        },
        "formFactor": "mobile",
        "chromeFlags": "--no-sandbox --disable-gpu"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.85, "aggregationMethod": "median-run" }],
        "categories:accessibility": ["error", { "minScore": 0.95, "aggregationMethod": "median-run" }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
        "categories:best-practices": ["warn", { "minScore": 0.85 }],
        "categories:seo": ["warn", { "minScore": 0.7 }]
      },
      "assertMatrix": [
        {
          "matchingUrlPattern": "http://localhost:5173/$",
          "assertions": {
            "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }]
          }
        },
        {
          "matchingUrlPattern": "http://localhost:5173/login",
          "assertions": {
            "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }]
          }
        },
        {
          "matchingUrlPattern": "http://localhost:5173/dashboard",
          "assertions": {
            "experimental-interaction-to-next-paint": ["error", { "maxNumericValue": 200 }]
          }
        },
        {
          "matchingUrlPattern": "http://localhost:5173/sales/invoices",
          "assertions": {
            "experimental-interaction-to-next-paint": ["error", { "maxNumericValue": 200 }]
          }
        }
      ]
    },
    "upload": { "target": "filesystem", "outputDir": ".lighthouseci" }
  }
}
