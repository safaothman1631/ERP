{
  "displayName": "Zoho ERP Firestore Foundation",
  "mosaicLayout": {
    "columns": 12,
    "tiles": [
      {
        "width": 6,
        "height": 4,
        "widget": {
          "title": "API p95 latency",
          "xyChart": {
            "dataSets": [{"timeSeriesQuery": {"timeSeriesFilter": {"filter": "metric.type=\"run.googleapis.com/request_latencies\""}}}]
          }
        }
      },
      {
        "xPos": 6,
        "width": 6,
        "height": 4,
        "widget": {
          "title": "Firestore reads (log-based)",
          "xyChart": {
            "dataSets": [{"timeSeriesQuery": {"timeSeriesFilter": {"filter": "jsonPayload.event=\"firestore_request\""}}}]
          }
        }
      }
    ]
  }
}
