# ============================================================================
# Kurdish ERP (Zoho-style) — Comprehensive .env template
# هاوبەشێکی تەواوی env بۆ Kurdish ERP
# ============================================================================
#
# HOW TO USE / چۆن بەکار بهێنیت:
#   1. Copy this file to `deploy/.env.deploy` (which is .gitignored).
#      ئەم فایلە کۆپی بکە بۆ `deploy/.env.deploy` (لە .gitignore ـدا هەیە).
#   2. Fill in every value marked REQUIRED. Optional values can stay blank.
#      هەموو نرخێکی REQUIRED پڕ بکەرەوە. ئەوانی OPTIONAL دەکرێت بەتاڵ بمێننەوە.
#   3. Production secrets live in GCP Secret Manager — see section "CI Secrets"
#      below for the GitHub Actions side, and `05-setup-secrets.ps1`.
#      نهێنیەکانی production لە GCP Secret Manager ـدان — بڕوانە بەشی
#      "CI Secrets" بۆ ئەو لایەنەی GitHub Actions، و `05-setup-secrets.ps1`.
#
# Cross-reference / ئاوێزانی:
#   - backend/app/config.py                       (Pydantic Settings)
#   - backend/app/observability/sentry.py         (init_sentry)
#   - backend/app/observability/logging.py        (LOG_LEVEL)
#   - backend/app/observability/tracing.py        (OTEL_*)
#   - backend/app/middleware/rate_limit_redis.py  (REDIS_URL / RATE_LIMIT_REDIS_URL)
#   - backend/app/services/rum_ingest.py          (RUM_BIGQUERY_DATASET + RUM_*)
#   - backend/app/services/cache.py               (REDIS_URL / CACHE_NAMESPACE)
#   - backend/app/services/backup_service.py      (FIREBASE_STORAGE_BUCKET)
#   - backend/app/services/integration_health.py  (SMTP_*)
#   - backend/app/firebase_client.py              (FIREBASE_*)
#   - backend/app/main.py                         (APP_VERSION / GIT_SHA)
#   - frontend/src/observability/sentry.ts        (VITE_SENTRY_DSN, VITE_APP_VERSION)
#   - frontend/src/observability/vitals.ts        (VITE_APP_VERSION)
#   - vercel.json                                 (${CLOUDRUN_URL})
#   - Dockerfile                                  (PORT, ENVIRONMENT)
#   - _deltas/P0-deps.md, _deltas/P4-deps.md      (canonical env-var tables)
#
# ============================================================================


# ╔══════════════════════════════════════════════════════════════════════════╗
# ║  SECTION 1 — FRONTEND BUILD-TIME (Vite reads as `import.meta.env.VITE_*`) ║
# ║  بەشی ١ — frontend لە کاتی build (Vite دەیخوێنێتەوە وەک VITE_*)            ║
# ╚══════════════════════════════════════════════════════════════════════════╝
# These are baked into the bundle at `npm run build` time. Changing one of
# these requires rebuilding the frontend. NEVER put a backend secret here.
# ئەمانە لە کاتی build لە بەستە دادەنرێن. گۆڕینیان پێویستی بە rebuild هەیە.
# هیچ کاتێک نهێنییەکی backend لێرە دامەنێ.

VITE_SENTRY_DSN=                  # REQUIRED in production — لە sentry.io دروست بکە. frontend.ts:initSentry throws if missing in prod (R6.4).
VITE_APP_VERSION=dev              # Auto-set in CI to the GitHub SHA. Used by Sentry release tag + RUM appVersion field.
VITE_API_BASE_URL=                # OPTIONAL — leave blank in production (Vercel `rewrites` proxies /api/* to Cloud Run). Set only for non-Vercel hosts.
VITE_APP_ENV=production           # Cosmetic environment label shown by EnvironmentBadge.
VITE_FIREBASE_PROJECT_ID=         # If frontend talks directly to Firestore (auth, live queries).
VITE_FIREBASE_API_KEY=            # Public Firebase web API key — safe to ship to clients.
VITE_FIREBASE_AUTH_DOMAIN=        # e.g. zoho-83cda.firebaseapp.com
VITE_FIREBASE_STORAGE_BUCKET=     # e.g. zoho-83cda.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# (Add more VITE_* here as features are added — they MUST be prefixed VITE_)


# ╔══════════════════════════════════════════════════════════════════════════╗
# ║  SECTION 2 — BACKEND RUNTIME (FastAPI / Cloud Run env vars)               ║
# ║  بەشی ٢ — backend لە کاتی runtime (Cloud Run env vars)                     ║
# ╚══════════════════════════════════════════════════════════════════════════╝
# Set via `gcloud run deploy --set-env-vars` (non-secret) and
# `--set-secrets` (secrets → Secret Manager). See `06-deploy-cloudrun.ps1`.

# ── 2.1 Core ──────────────────────────────────────────────────────────────
APP_NAME=zoho-erp-backend
ENVIRONMENT=production            # production | development. Production = strict env validation + mandatory Sentry. (config.py:validate_env)
DEBUG=false                       # MUST be false in production. validate_env hard-fails otherwise.
APP_VERSION=                      # GitHub SHA — injected by CI into Cloud Run. Surfaces in /api/health + Sentry release.
GIT_SHA=                          # Optional duplicate of APP_VERSION for legacy callers.
APP_ENV=production                # /api/health response field.

# ── 2.2 Security ──────────────────────────────────────────────────────────
SECRET_KEY=                       # REQUIRED. JWT signing key, ≥ 32 chars cryptographically random. Stored in Secret Manager as `zoho-secret-key`.
ACCESS_TOKEN_EXPIRE_MINUTES_SHORT=60   # Login access token TTL (1h). Requirement 2.8.
REFRESH_TOKEN_EXPIRE_DAYS=7            # Refresh token TTL (7d). Requirement 2.8.
ALGORITHM=HS256                        # JWT signing algorithm.
FIELD_ENCRYPTION_KEY=                  # Fernet key (url-safe base64, 32 bytes) for PII column encryption. Secret Manager: `field-encryption-key`.
FIELD_ENCRYPTION_KEY_PREVIOUS=         # Optional rotated-out key for backward compatibility.

# ── 2.3 Observability — Sentry ────────────────────────────────────────────
SENTRY_DSN=                       # REQUIRED in production (raises SentryConfigurationError). Different project from VITE_SENTRY_DSN.
SENTRY_AUTH_TOKEN=                # Used by scripts/sentry-release-tag.sh + sourcemap upload. CI secret only.
SENTRY_ORG=                       # e.g. "kurdish-erp". Used by sentry-release-tag.sh.
SENTRY_PROJECT=zoho-backend       # Sentry project slug for the backend.
SENTRY_ENVIRONMENT=production     # Tag attached to Sentry releases.

# ── 2.4 Observability — Logging / Tracing ─────────────────────────────────
LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR. (observability/logging.py)
OTEL_SERVICE_NAME=zoho-backend    # Resource tag for exported OpenTelemetry spans. (observability/tracing.py)

# ── 2.5 Observability — RUM (Real User Monitoring) ────────────────────────
RUM_BIGQUERY_DATASET=             # OPTIONAL. When set, web-vitals batches are streamed to BigQuery. Unset = log-only.
RUM_BIGQUERY_PROJECT=             # GCP project for the BigQuery dataset (defaults to deploy project).
RUM_BIGQUERY_TABLE=vitals_raw     # BigQuery table name; default `vitals_raw`.
RUM_FLUSH_INTERVAL_S=5            # Background flush interval (seconds).
RUM_HIGH_WATERMARK=100            # Force early flush when queue exceeds this size.
RUM_QUEUE_MAX=10000               # Hard cap on the in-process queue.

# ── 2.6 Database ──────────────────────────────────────────────────────────
DATABASE_URL=                     # REQUIRED. Postgres connection string. Cloud SQL: `postgresql://user:pass@/db?host=/cloudsql/<inst>`. Falls back to sqlite in dev only.
RUN_MIGRATIONS_ON_BOOT=true       # Apply Alembic migrations during container startup.
APPLY_MIGRATIONS_ON_BOOT=false    # Legacy alias — leave false in new deployments.

# ── 2.7 Firebase / Firestore ──────────────────────────────────────────────
FIREBASE_PROJECT_ID=              # GCP project ID (same as $GCP_PROJECT_ID for the deploy).
FIREBASE_CREDENTIALS_PATH=        # Leave blank on Cloud Run — workload-identity ADC is used automatically.
GOOGLE_APPLICATION_CREDENTIALS=   # Alternative ADC path. NOT NEEDED on Cloud Run.
FIREBASE_STORAGE_BUCKET=          # e.g. zoho-83cda.appspot.com. Used for backup_service + exports.

# ── 2.8 CORS ──────────────────────────────────────────────────────────────
# Comma-separated list of EXACT origins (no wildcards in production —
# validate_env hard-fails on `*`).
CORS_ORIGINS=https://erp.example.com,https://www.erp.example.com

# ── 2.9 Cache / Redis ─────────────────────────────────────────────────────
REDIS_URL=                        # redis://10.x.x.x:6379 (Memorystore). Stored in Secret Manager as `zoho-redis-url`.
RATE_LIMIT_REDIS_URL=             # OPTIONAL override just for slowapi limiter. Falls back to REDIS_URL.
RATE_LIMIT_STORAGE_URI=           # Legacy alias preferred by config.py; same value as RATE_LIMIT_REDIS_URL.
CACHE_NAMESPACE=zoho:prod         # Prefix for all cache keys (avoid collisions when sharing Redis).
CACHE_TTL_SECONDS=300
CACHE_ENABLED=true

# ── 2.10 Rate limiting ───────────────────────────────────────────────────
RATE_LIMITING_ENABLED=true        # Master switch. (Requirement 10.3)
DEFAULT_RATE_LIMIT=100/minute     # Default for anonymous IPs. Format: "<count>/<period>".

# ── 2.11 Feature flags / behaviour ───────────────────────────────────────
USE_FIRESTORE_QUERY=true          # Server-side list_page for hot collections.
FS_METRICS_ENABLED=true           # Firestore metrics emission.
IDEMPOTENCY_ENABLED=true          # Idempotency-Key middleware.
GL_MATERIALISATION_ENABLED=false  # Wave M: GL projections (only enable post-warmup).
GENERIC_WRITE_VALIDATION=true     # Strict schema validation on writes.
AUDIT_RETENTION_MONTHS=24         # Audit log retention.
SEARCH_PREFIX_ENABLED=false       # /api/search prefix queries (needs Firestore indexes).
PLATFORM_IMPERSONATION_ENABLED=false   # Platform-admin "view as" feature.
PLATFORM_ADMIN_USER_IDS=          # Comma-sep list of UIDs allowed to impersonate.

# ── 2.12 Email (SMTP) ────────────────────────────────────────────────────
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=                    # Secret Manager: `smtp-password`.
EMAIL_FROM=no-reply@erp.example.com

# ── 2.13 Health probes / DR ──────────────────────────────────────────────
PROBE_AUDIT_DIR=/tmp/probe-audit   # Where /api/health/offline writes evidence.


# ╔══════════════════════════════════════════════════════════════════════════╗
# ║  SECTION 3 — DEPLOY-TIME (GCP / Cloud Run)                                ║
# ║  بەشی ٣ — env بۆ deploy (GCP / Cloud Run)                                  ║
# ╚══════════════════════════════════════════════════════════════════════════╝
# Consumed by the PowerShell deploy scripts and GitHub Actions.

GCP_PROJECT_ID=                   # REQUIRED. e.g. kurdish-erp-prod.
GCP_REGION=me-central1            # Middle East region (Doha). Override per geography.
GCP_ARTIFACT_REPO=zoho-images     # Artifact Registry repo name (created by 06a-setup-gcp-resources.ps1).
GCP_SERVICE_NAME=zoho-erp-backend # Cloud Run service name.
GCP_SERVICE_MIN_INSTANCES=1       # Always-on instances. Costs ~$30-50/mo each. (Cost gate in 06-deploy-cloudrun.ps1)
GCP_SERVICE_MAX_INSTANCES=20
GCP_SERVICE_MEMORY=1Gi
GCP_SERVICE_CPU=2
GCP_SERVICE_CONCURRENCY=80
GCP_VPC_CONNECTOR=erpiq-run-connector   # Optional VPC connector for Memorystore Redis.

# Workload Identity Federation (GitHub → GCP — no service-account keys)
GCP_WIF_PROVIDER=projects/123456789/locations/global/workloadIdentityPools/github/providers/github
GCP_SERVICE_ACCOUNT=github-deployer@kurdish-erp-prod.iam.gserviceaccount.com

CLOUDRUN_URL=                     # Filled after first deploy; written to deploy/cloudrun-url.txt. Referenced by Vercel.


# ╔══════════════════════════════════════════════════════════════════════════╗
# ║  SECTION 4 — DEPLOY-TIME (Vercel — frontend)                              ║
# ║  بەشی ٤ — env بۆ deploy (Vercel — frontend)                                ║
# ╚══════════════════════════════════════════════════════════════════════════╝
# vercel.json's `rewrites` substitutes ${CLOUDRUN_URL} from Vercel project env.

VERCEL_TOKEN=                     # Personal token from vercel.com/account/tokens. CI secret only.
VERCEL_ORG_ID=                    # team_xxxxx — vercel team/org ID.
VERCEL_PROJECT_ID=                # prj_xxxxx — vercel project ID.
VERCEL_PROJECT_NAME=zoho-erp-frontend
VERCEL_SCOPE=                     # Optional team scope slug.


# ╔══════════════════════════════════════════════════════════════════════════╗
# ║  SECTION 5 — CI SECRETS (GitHub Actions)                                  ║
# ║  بەشی ٥ — نهێنیەکانی CI (GitHub Actions)                                    ║
# ╚══════════════════════════════════════════════════════════════════════════╝
# These are NOT used at runtime — they live in
# `gh secret set <NAME>` and are referenced as ${{ secrets.NAME }} in YAML.
# لە GitHub Actions ـدا بەکار دێن، لە کاتی runtime ـدا پێویست نین.
#
# Required set (14 secrets): see deploy/CHECKLIST.md.

# --- Tokens ---
GH_TOKEN=                         # Personal access token. Used by deploy-production.yml's ci-gate to read prior workflow status.
SENTRY_AUTH_TOKEN=                # See section 2.3 — for source-map upload + release tagging.
VERCEL_TOKEN=                     # See section 4.

# --- IDs / URLs ---
# GCP_PROJECT_ID                  → set above
# GCP_WIF_PROVIDER                → set above
# GCP_SERVICE_ACCOUNT             → set above
# VERCEL_ORG_ID                   → set above
# VERCEL_PROJECT_ID               → set above
# CLOUDRUN_URL                    → set above (smoke-test job reads this)

# --- Load testing (k6) ---
LOAD_TEST_TARGET_URL=https://staging-backend.run.app
LOAD_TEST_USER_EMAIL=loadtest@example.com
LOAD_TEST_USER_PASSWORD=          # Secret Manager: `loadtest-password`.
LOAD_TEST_TENANT_ID=tenant_loadtest

# --- Scorecard / probes ---
PROBE_TARGET_URL=                 # Defaults to CLOUDRUN_URL. Used by production-reality-probe.mjs.


# ╔══════════════════════════════════════════════════════════════════════════╗
# ║  SECTION 6 — OPTIONAL FEATURES                                            ║
# ║  بەشی ٦ — تایبەتمەندیە ئیختیاریەکان                                          ║
# ╚══════════════════════════════════════════════════════════════════════════╝

# ── 6.1 BigQuery (RUM destination) ───────────────────────────────────────
# Already covered in section 2.5.

# ── 6.2 Iraq localisation / e-invoice ────────────────────────────────────
EINVOICE_TENANT_ID=
EINVOICE_API_BASE=https://etax.iq/api  # Placeholder — replace with the real ITA endpoint when issued.
EINVOICE_API_KEY=                       # Secret Manager: `einvoice-api-key`.

# ── 6.3 WhatsApp / OCR (Wave I) ──────────────────────────────────────────
WHATSAPP_API_TOKEN=               # Secret Manager: `whatsapp-api-token`.
WHATSAPP_PHONE_NUMBER_ID=
OCR_PROVIDER=tesseract            # tesseract | google-vision
GOOGLE_VISION_API_KEY=            # Only when OCR_PROVIDER=google-vision.

# ── 6.4 CSP report endpoint ──────────────────────────────────────────────
# vercel.json sets Content-Security-Policy-Report-Only with
# report-uri=/api/csp-report. The backend stores reports for 14 days
# during the report-only soak before enforcement is enabled.
CSP_REPORT_RETENTION_DAYS=14

# ── 6.5 Backup verification cron ────────────────────────────────────────
BACKUP_VERIFY_CRON_ENABLED=true
BACKUP_VERIFY_TARGET_BUCKET=      # GCS bucket for nightly restore tests.

# ── 6.6 Field service / mobile push ─────────────────────────────────────
FCM_SERVER_KEY=                   # Secret Manager: `fcm-server-key`.


# ============================================================================
# END
# ============================================================================
