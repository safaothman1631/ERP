# Marketing site environment example.
# Copy to `.env` for local dev; set in Vercel project settings for production.

# Canonical site URL (used for OG, hreflang, sitemap)
PUBLIC_SITE_URL=https://zoho-kurdish.iq

# Application origin — used for login / signup CTAs and lead POSTs
PUBLIC_APP_URL=https://app.zoho-kurdish.iq

# Marketing leads endpoint (POST email captures and contact-form submissions)
# Expected: 201 on success, JSON body { ok: true }
PUBLIC_LEADS_ENDPOINT=https://app.zoho-kurdish.iq/api/marketing/leads

# Plausible (preferred analytics, cookie-less)
# PUBLIC_PLAUSIBLE_DOMAIN=zoho-kurdish.iq
# PUBLIC_PLAUSIBLE_SRC=https://plausible.zoho-kurdish.iq/js/script.js

# Google Analytics 4 (fallback; requires cookie consent before loading)
# PUBLIC_GA4_ID=G-XXXXXXXXXX
