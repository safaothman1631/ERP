---
/**
 * MarketingLayout — BaseLayout + Header + Footer.
 *
 * Use this for every marketing-funnel page (landing, pricing, features, about, contact, blog).
 */
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import type { Locale } from '../i18n/utils';

export interface Props {
  title: string;
  description?: string;
  locale?: Locale;
  path?: string;
  ogImage?: string;
  schemaType?: 'WebPage' | 'Article' | 'FAQPage' | 'Product';
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
}

const props = Astro.props;
---

<BaseLayout {...props}>
  <Header />
  <main id="main" role="main" class="flex-1">
    <slot />
  </main>
  <Footer />
  <CookieBanner />
</BaseLayout>
