---
import { t, type Locale, localizedPath } from '../../i18n/utils';
import MarketingLayout from '../../layouts/MarketingLayout.astro';
import { getCollection } from 'astro:content';

export interface Props { locale: Locale; }
const { locale } = Astro.props;

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const fmtDate = (d: Date) =>
  new Intl.DateTimeFormat(
    locale === 'ku' ? 'ar-IQ' : locale === 'ar' ? 'ar-IQ' : 'en-US',
    { year: 'numeric', month: 'long', day: 'numeric' }
  ).format(d);
---

<MarketingLayout
  locale={locale}
  title={t('blog.title', locale)}
  description={t('blog.sub', locale)}
>
  <section class="section pt-16">
    <div class="container-marketing max-w-4xl">
      <h1 class="font-display font-bold text-4xl md:text-display-sm text-ink-950 mb-3 text-balance">
        {t('blog.title', locale)}
      </h1>
      <p class="text-lg text-ink-600 mb-10 text-pretty">{t('blog.sub', locale)}</p>

      <div class="space-y-4">
        {posts.map((p) => (
          <a
            href={localizedPath(locale, `/blog/${p.slug}`)}
            class="card block hover:border-brand-200 no-underline"
          >
            <div class="flex items-start justify-between gap-4 mb-2">
              <h2 class="font-display font-semibold text-xl text-ink-900">{p.data.title}</h2>
              <span class="text-xs text-ink-500 shrink-0 whitespace-nowrap">{fmtDate(p.data.date)}</span>
            </div>
            <p class="text-ink-600 text-sm text-pretty mb-3">{p.data.description}</p>
            <div class="flex flex-wrap items-center gap-2">
              {p.data.tags.slice(0, 3).map((tag) => (
                <span class="px-2 py-0.5 text-xs rounded-full bg-ink-100 text-ink-700">{tag}</span>
              ))}
              {p.data.reading_minutes && (
                <span class="text-xs text-ink-500 ms-auto">{p.data.reading_minutes} {t('blog.minutes', locale)}</span>
              )}
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</MarketingLayout>
