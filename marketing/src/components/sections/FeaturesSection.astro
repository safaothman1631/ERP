---
import { t, type Locale } from '../../i18n/utils';
import FeatureCard from '../FeatureCard.astro';
export interface Props { locale: Locale; }
const { locale } = Astro.props;
const features = [
  { icon: '🛒', title: t('feature.pos.title', locale),        body: t('feature.pos.body', locale),        color: 'brand' as const },
  { icon: '📊', title: t('feature.accounting.title', locale), body: t('feature.accounting.body', locale), color: 'accent' as const },
  { icon: '📦', title: t('feature.inventory.title', locale),  body: t('feature.inventory.body', locale),  color: 'brand' as const },
  { icon: '👥', title: t('feature.payroll.title', locale),    body: t('feature.payroll.body', locale),    color: 'accent' as const },
  { icon: '📋', title: t('feature.einvoice.title', locale),   body: t('feature.einvoice.body', locale),   color: 'brand' as const },
  { icon: '📈', title: t('feature.reports.title', locale),    body: t('feature.reports.body', locale),    color: 'accent' as const },
];
---
<section class="section">
  <div class="container-marketing">
    <div class="max-w-2xl mx-auto text-center mb-12">
      <h2 class="font-display font-bold text-3xl md:text-4xl text-ink-950 mb-4 text-balance">{t('features.title', locale)}</h2>
      <p class="text-lg text-ink-600 text-pretty">{t('features.sub', locale)}</p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {features.map((f) => (
        <FeatureCard title={f.title} body={f.body} icon={f.icon} color={f.color} />
      ))}
    </div>
  </div>
</section>
