{
  "name": "@zoho-kurd/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Capacitor wrapper for the Zoho Kurdish ERP — reuses the frontend Vite build 1:1 for Android + iOS native shells.",
  "scripts": {
    "build": "npm --prefix ../frontend run build && cap copy",
    "build:android": "npm run build && cap copy android && cap sync android",
    "build:ios": "npm run build && cap copy ios && cap sync ios",
    "android": "cap open android",
    "ios": "cap open ios",
    "sync": "cap sync",
    "copy": "cap copy",
    "doctor": "cap doctor",
    "add:android": "cap add android",
    "add:ios": "cap add ios",
    "init": "echo 'Already initialised. Run npm run add:android or npm run add:ios to scaffold a platform.'",
    "clean": "rimraf android/app/build ios/App/build node_modules"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.0",
    "@capacitor/core": "^6.1.0",
    "@capacitor/ios": "^6.1.0",
    "@capacitor/splash-screen": "^6.0.2",
    "@capacitor/status-bar": "^6.0.1",
    "@capacitor/preferences": "^6.0.2",
    "@capacitor/filesystem": "^6.0.1",
    "@capacitor/network": "^6.0.2",
    "@capacitor-community/bluetooth-le": "^7.1.0",
    "@capacitor-mlkit/barcode-scanning": "^6.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.0",
    "rimraf": "^5.0.5",
    "typescript": "^5.4.5"
  },
  "workspaces": {
    "nohoist": ["**/@capacitor/**", "**/@capacitor-community/**", "**/@capacitor-mlkit/**"]
  },
  "engines": {
    "node": ">=20"
  }
}
