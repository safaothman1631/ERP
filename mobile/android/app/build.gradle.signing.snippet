// ─────────────────────────────────────────────────────────────────────────
// Zoho Kurdish ERP — Android signing config snippet.
//
// MERGE this block into `android/app/build.gradle` AFTER the platform is
// scaffolded via `npx cap add android`. Until then `android/` does not
// exist on disk, so this file lives as a `.snippet` and is referenced
// from `docs/mobile/android-signing.md`.
//
// Where to merge:
//   android { ... ► insert `signingConfigs` BEFORE `buildTypes`.
//
// The env vars below are populated by Fastlane (`_restore_keystore_from_env`)
// or by CI directly (`mobile-android-beta.yml`). They MUST never be hard-coded.
// ─────────────────────────────────────────────────────────────────────────

android {
  // … existing `compileSdk`, `defaultConfig`, etc.

  signingConfigs {
    release {
      storeFile file(System.getenv("KEYSTORE_PATH") ?: "upload.jks")
      storePassword System.getenv("KEYSTORE_PASSWORD")
      keyAlias System.getenv("KEY_ALIAS")
      keyPassword System.getenv("KEY_PASSWORD")
      // Enable v2 signing (required by Play App Signing).
      v2SigningEnabled true
      // v1 signing is still required for devices < API 24.
      v1SigningEnabled true
    }
  }

  buildTypes {
    release {
      signingConfig signingConfigs.release
      minifyEnabled true
      shrinkResources true
      proguardFiles getDefaultProguardFile('proguard-android-optimize.txt'), 'proguard-rules.pro'
    }
    debug {
      // Debug keystore is auto-generated by Gradle; no signingConfig needed.
      applicationIdSuffix ".debug"
      versionNameSuffix "-debug"
    }
  }
}

// ─────────────────────────────────────────────────────────────────────────
// Crashlytics + Firebase Messaging — apply at the BOTTOM of build.gradle
// (after `apply plugin: 'com.android.application'`).
// ─────────────────────────────────────────────────────────────────────────
apply plugin: 'com.google.gms.google-services'
apply plugin: 'com.google.firebase.crashlytics'

// Required dependencies block (merge into existing `dependencies { }`):
//   implementation platform('com.google.firebase:firebase-bom:33.1.2')
//   implementation 'com.google.firebase:firebase-messaging'
//   implementation 'com.google.firebase:firebase-crashlytics'
//   implementation 'com.google.firebase:firebase-analytics'
